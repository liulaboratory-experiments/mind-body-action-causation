sessionInfo()
base_path <- here("code", "analysis", "pilot")
freesort_and_causal_distances_df_path <- paste0(base_path, "/data-explanation_1/freesort_minus_causals.csv")
distances <- read.csv(freesort_and_causal_distances_df_path)
summary(distances)
target_items <- c("take a walk", "reach for something")
# Step 1: Filter for rows where *one* of the items is in target_items
closest_candidates <- distances %>%
filter((itemA %in% target_items & !(itemB %in% target_items)) |
(itemB %in% target_items & !(itemA %in% target_items))) %>%
mutate(other_item = ifelse(itemA %in% target_items, itemB, itemA))
# Step 2: Group by that "other" item, and summarize total distance
closest_summary <- closest_candidates %>%
group_by(other_item) %>%
summarise(total_freesort_distance = sum(mean_freesort_distance),
total_causal_distance = sum(mean_causal_distance),
total_combined = total_freesort_distance + total_causal_distance) %>%
arrange(total_freesort_distance)
# View the closest item(s)
head(closest_summary)
