# your prior processing...
group_by(condition, itemB) %>%
mutate(total = n()) %>%
group_by(condition, itemB, response) %>%
mutate(
count = n(),
total = first(total),
mean_proportion = count / total,
se = sqrt(mean_proportion * (1 - mean_proportion) / total)
) %>%
distinct(condition, itemB, .keep_all = TRUE) %>%
ungroup() %>%
filter(response == "causal") %>%
filter(trial_ID %in% c("take a walk_jump up and down_think about something",
"reach for something_kick something_become hungry")) %>%
# mutate(label_combo = paste("B:", itemB,
#                            "| Causal:", causal_itemA,
#                            "| Similar:", similarity_itemA)) %>%
ggplot(aes(x = causal_itemA_freesort_minus_causal,
y = mean_proportion,
#label = label_combo
)) +
geom_point() +
geom_text(size = 3, aes(label = itemB)) +
geom_text(size = 3,
nudge_y = .005,
aes(label = causal_itemA)) +
geom_text(size = 3,
nudge_y = .01,
aes(label = similarity_itemA)) +
# geom_smooth(method = "lm") +
theme_bw()
