distinct(itemB, condition, item_label, item, mean_proportion)
dat_long %>%
ggplot(aes(x = condition, y = mean_proportion, fill = response)) +
geom_bar(stat = "identity") +
geom_bar(stat = "identity", colour = "black") +
geom_errorbar(
data = filter(dat_summarized_by_item, response == "causal"),
aes(ymax = mean_proportion + se, ymin = mean_proportion - se),
stat = "identity", position = "identity", width = 0.3
) +
geom_text(
data = label_data,
aes(x = condition, y = mean_proportion + 0.05, label = item),
inherit.aes = FALSE,
size = 3.5
) +
scale_fill_manual(values = c("grey80", "#000000")) +
theme_cowplot() +
facet_wrap(~itemB, nrow = 3)
knitr::opts_chunk$set(echo = TRUE)
options(scipen = 1, digits = 3)
